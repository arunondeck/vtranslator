{
  "expo": {
    "name": "Translator Speaker",
    "slug": "translator-speaker",
    "version": "1.0.0",
    "orientation": "portrait",
    "plugins": [
      "expo-dev-client"
    ],
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Allow Translator Speaker to record speech for live transcription."
      }
    },
    "android": {
      "permissions": [
        "RECORD_AUDIO",
        "RECORD_AUDIO"
      ],
      "package": "com.anonymous.translatorspeaker"
    }
  }
}
