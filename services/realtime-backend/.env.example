PORT=4000
# Bind interface. Keep 0.0.0.0 so the process accepts external connections on PaaS hosts.
HOST=0.0.0.0
USE_MOCK_TRANSCRIPTION=true
SARVAM_API_KEY=
SARVAM_API_BASE_URL=https://api.sarvam.ai
# Local dev: * is fine. Production: set to your web-viewer origin, e.g. https://web-viewer.onrender.com
# Render blueprint wires this from the web-viewer service automatically.
CORS_ORIGIN=*

# Sarvam streaming speech-to-text-translate (saaras:v3) settings.
SARVAM_STREAM_MODEL=saaras:v3
SARVAM_INPUT_CODEC=pcm_s16le
SARVAM_SAMPLE_RATE=16000
# high VAD sensitivity uses a ~0.5s silence boundary for snappier utterances.
SARVAM_HIGH_VAD_SENSITIVITY=true
SARVAM_VAD_SIGNALS=true
# Rolling window (characters) of accumulated transcript kept per language.
TRANSCRIPT_WINDOW_CHARS=800

# Soniox AI service (optional REST endpoints under /soniox)
SONIOX_API_KEY=
SONIOX_REGION=
SONIOX_BASE_DOMAIN=
SONIOX_API_BASE_URL=
SONIOX_WS_URL=
SONIOX_TTS_API_URL=
SONIOX_TTS_WS_URL=
SONIOX_STT_MODEL=stt-rt-v5
SONIOX_STREAM_PACE_MS=60
SONIOX_INPUT_LANGUAGES=en,ml,ar,ms,hi
SONIOX_OUTPUT_LANGUAGES=hi,ml,en,bn,ms
SONIOX_DEFAULT_INPUT_MODE=mixed
SONIOX_DEFAULT_INPUT_LANGUAGE=en
